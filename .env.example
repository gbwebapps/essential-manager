# Copiare in .env e completare i valori prima di avviare l'installazione.
# .env resta locale. Per il server pubblico impostare CI_ENVIRONMENT = production.
CI_ENVIRONMENT = development

# URL pubblico, con / finale. In una sottocartella includere anche il percorso.
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
cookie.path = '/'
# HTTP locale; in produzione HTTPS impostare true.
cookie.secure = false

database.default.hostname = localhost
database.default.database = essential_manager
database.default.username = INSERIRE_UTENTE_DATABASE
database.default.password = 'INSERIRE_PASSWORD_DATABASE'
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.port = 3306

# Generare una nuova chiave con php spark key:generate dopo la configurazione.
# Per ripristinare un'installazione esistente recuperare invece la sua chiave originale.
encryption.key =

users.enabled = false
users.registration = false
pages.enabled = false
contacts.enabled = false
contacts.notificationRecipient = ''
