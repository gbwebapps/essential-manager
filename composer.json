{
    "name": "essential/manager",
    "description": "Essential application",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "essential/framework": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Modules\\": "modules/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "pre-autoload-dump": "@php vendor/essential/framework/publish-package.php"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/gbwebapps/essential-framework.git"
        }
    ],
    "extra": {
        "essential": {
            "development-tools": false
        }
    }
}
